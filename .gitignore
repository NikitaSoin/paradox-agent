# Ключи — НИКОГДА в репозиторий. На хостинге они задаются переменными окружения.
.env
.env.local
app/.env

# Ставится на сервере при сборке (33 МБ)
node_modules/
dist/

# Исходные материалы СКОЛКОВО и архивы: приложению для работы не нужны, лежат
# локально. В репозитории от них только вес (~15 МБ) и лишняя копия чужих
# документов с именами людей.
archive/
extracted/
prototype/
*.zip

# Локальные запускалки для «дважды кликнуть» на своей машине
app/start.command
app/start.bat
app/share.command

.DS_Store

# Файл с настоящими ключами — только локально, в репозиторий не уезжает
СТАРТ_С_КЛЮЧАМИ.md
